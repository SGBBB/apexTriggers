trigger AccountEditTrigger on Account (after update) { // since extra dml-cost is incurred over here, it can't never be run in before context.
    if(Trigger.isbefore && Trigger.isUpdate && !Trigger.new.isEmpty()){
        Set<Id> accountBillingAddressChanged=new Set<Id>();
        for(Account accountRecordNew:Trigger.new){
            Account accountRecordOld=Trigger.oldMap.get(accountRecordNew.Id);
            System.debug('testDebug1 ' + accountRecordNew.BillingStreet + ' -- '+accountRecordOld.BillingStreet);
            if(accountRecordNew.BillingStreet!=accountRecordOld.BillingStreet){
                accountBillingAddressChanged.add(accountRecordNew.Id);
            }
        }
         
  		
         
        //Map to store contact belonging to accountBillingAddressChanged set
		Map<Id,Contact> contactsWithUpdateAccounts=new Map<Id,Contact>([Select Id,AccountId,Name,mailingstreet   from Contact where AccountId in:accountBillingAddressChanged ]);        
        
        List<Contact> contactListToUpdate=new List<Contact>();
        for(Contact curContact:contactsWithUpdateAccounts.values()){
            //We are iterating over the new Map because the values are not updated to db.
            
            curContact.MailingStreet=Trigger.newMap.get(curContact.AccountId).billingstreet;
            contactListToUpdate.add(curContact);
        }
        
        
        if(!contactListToUpdate.isEmpty()) {
            UPDATE contactListToUpdate;
        }
    }
}
    

    

